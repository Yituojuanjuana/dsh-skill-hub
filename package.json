{
  "name": "dsh-skill-shelf",
  "version": "0.6.0",
  "description": "Browse, search and switch every local skill in one dsh Web GUI panel, with day / week / total call counts from an append-only ledger, install-time content audit, GitHub sources with commit pins, local-edit detection, cross-agent and ZIP import, and a restorable trash.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-cordis",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "guided",
      "adapter": "third-party",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "hot-reload",
      "dispose": "supported"
    },
    "permissions": [
      "fs:read",
      "fs:write",
      "net:https",
      "net:loopback"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.7-alpha.1",
        "0.1.7-alpha.2",
        "0.1.7-rc.1",
        "0.1.7-rc.2",
        "0.2.0-rc.1",
        "0.2.0-rc.2",
        "0.2.1-alpha.2",
        "0.2.1-alpha.5",
        "0.2.1-rc.2",
        "0.2.2-alpha.2",
        "0.2.2-alpha.3",
        "0.2.2-rc.1",
        "0.2.2-rc.2",
        "0.2.2-rc.3",
        "0.2.3-alpha.2"
      ]
    },
    "capability": {
      "id": "skill-shelf-settings-panel",
      "kind": "ui",
      "invocation": "Open Settings → Skill Shelf (技能书架), or the 960 px sidebar panel; GET /api/skill-shelf/catalog",
      "expected": "The full local skill catalog (all roots) renders as groups with day / week / total call counts, and toggles persist an enabled/disabled row without a restart."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.2 || ^4.0.5-alpha.1 || ^4.0.5-alpha.2 || ^4.0.6-alpha.1 || ^4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-session-query": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-skill": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-alpha.1 <0.3.0-0 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-alpha.2 <0.2.1 || >=0.2.2-alpha.2 <0.2.2 || >=0.2.3-alpha.2 <0.2.3",
    "@deepseek-ai/schemastery": "^3.18.3 || ^3.18.5-alpha.1 || ^3.18.5-alpha.2 || ^3.18.6-alpha.1 || ^3.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
